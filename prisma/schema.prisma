generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int       @id @default(autoincrement())
  telegramId           BigInt    @unique
  uid                  String?   @unique
  usernameTg           String?
  firstNameTg          String?
  displayName          String?
  fullName             String?
  email                String?
  phone                String?
  country              String?
  passwordHash         String?
  registered           Boolean   @default(false)
  registeredAt         DateTime?
  usdtBalance          Decimal   @default(0) @db.Decimal(18, 6)
  earnBalance          Decimal   @default(0) @db.Decimal(18, 6)
  accountNumber        String?   @unique
  accountRequestStatus String    @default("none") // none / pending / assigned
  cardNumber           String?
  cardRequestStatus    String    @default("none") // none / pending / assigned
  kycStatus            String    @default("none") // none / pending / approved / rejected
  kycRejectReason      String?
  verified             Boolean   @default(false)
  verifiedAt           DateTime?
  isAdmin              Boolean   @default(false)
  banned               Boolean   @default(false)
  banReason            String?
  opsLocked            Boolean   @default(false)
  opsLockReason        String?
  transfersDisabled    Boolean   @default(false)
  conversionsDisabled  Boolean   @default(false)
  transferLockReason   String?
  convertLockReason    String?
  authEpoch            Int       @default(0)
  sessionTokenHash     String?
  totpEnabled          Boolean   @default(false)
  totpSecret           String?
  totpPendingSecret    String?
  totpBackupHashes     String?
  totpTempTokenHash    String?
  totpTempExpires      DateTime?
  walletBranch         String?
  createdAt            DateTime  @default(now())

  transfersSent     Transfer[]       @relation("TransfersSent")
  transfersReceived Transfer[]       @relation("TransfersReceived")
  balanceHistory    BalanceHistory[]
  supportThreads    SupportThread[]
  depositAddresses  DepositAddress[]
  kycDocuments      KycDocument[]
  financeRequests   FinanceRequest[]
  assetBalances     AssetBalance[]
}

model AssetBalance {
  id        Int      @id @default(autoincrement())
  userId    Int
  asset     String
  amount    Decimal  @default(0) @db.Decimal(24, 12)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, asset])
  @@index([userId])
}

model DepositAddress {
  id        Int      @id @default(autoincrement())
  userId    Int
  asset     String   // USDT / BTC
  network   String   // TRC20 / ERC20 / BTC
  address   String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, asset, network])
}

model WalletPool {
  id        Int      @id @default(autoincrement())
  code      String
  asset     String
  network   String
  address   String
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([code, asset, network])
  @@unique([asset, network, address])
  @@index([asset, network])
  @@index([code])
}

model IncomingDeposit {
  id          Int      @id @default(autoincrement())
  txHash      String
  fromAddress String   @default("")
  toAddress   String
  amount      Decimal  @db.Decimal(24, 12)
  usdAmount   Decimal? @db.Decimal(18, 2)
  asset       String
  network     String
  branchCode  String
  confirmed   Boolean  @default(true)
  seenAt      DateTime @default(now())

  @@unique([txHash, toAddress, asset, network])
  @@index([seenAt])
  @@index([branchCode])
}

model KycDocument {
  id           Int      @id @default(autoincrement())
  userId       Int
  type         String   // id_front / id_back / selfie
  filename     String
  originalName String?
  mimeType     String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
}

model Transfer {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  amount     Decimal  @db.Decimal(18, 6)
  createdAt  DateTime @default(now())

  fromUser User @relation("TransfersSent", fields: [fromUserId], references: [id])
  toUser   User @relation("TransfersReceived", fields: [toUserId], references: [id])
}

model BalanceHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  amount    Decimal  @db.Decimal(18, 6)
  balance   Decimal  @db.Decimal(18, 6)
  meta      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SupportThread {
  id          Int       @id @default(autoincrement())
  userId      Int
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  adminReadAt DateTime?

  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]
}

model SupportMessage {
  id           Int      @id @default(autoincrement())
  threadId     Int
  sender       String
  text         String   @default("")
  filename     String?
  originalName String?
  mimeType     String?
  createdAt    DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id])
}


model FinanceRequest {
  id         Int       @id @default(autoincrement())
  userId     Int
  type       String    // withdraw_onchain / withdraw_card / convert / earn
  status     String    @default("pending") // pending / approved / rejected
  amount     Decimal?  @db.Decimal(24, 12)
  asset      String?
  network    String?
  toAddress  String?
  toAsset    String?
  toAmount   Decimal?  @db.Decimal(24, 12)
  meta       String?
  adminNote  String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([type])
}
